#!/usr/bin/env python3
"""
Seed the local dev Home Assistant instance with sample Simple Chores data:
categories, chores, privileges, and a mix of completions/resets/missed
activity so the frontend has something to look at.

Expects a clean instance - onboarded, with the Simple Chores integration
already added (Settings -> Devices & Services -> Add Integration). Re-run
after wiping config/ and redoing those two steps; it doesn't try to detect
or skip data that's already there.

Needs a long-lived access token: click your name (bottom left of the HA
UI) -> Security -> Long-Lived Access Tokens -> Create Token. A fresh
instance means a fresh token every time, since the token is tied to the
user account that onboarding just recreated.

Usage:
  HA_TOKEN=... scripts/seed
  scripts/seed --token ... --url http://localhost:8123
  scripts/seed --dry-run   # print the service calls without making them
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

DOMAIN = "simple_chores"

CATEGORIES = [
    {"name": "Kitchen", "slug": "kitchen", "icon": "mdi:silverware-fork-knife"},
    {"name": "Bedroom", "slug": "bedroom", "icon": "mdi:bed"},
    {"name": "Outdoor", "slug": "outdoor", "icon": "mdi:tree"},
    {"name": "Homework", "slug": "homework", "icon": "mdi:book-open-variant"},
]

CHORES = [
    {
        "name": "Wash the dishes",
        "slug": "wash_dishes",
        "frequency": "daily",
        "assignees": "alice,bob",
        "points": 5,
        "category": "kitchen",
    },
    {
        "name": "Take out the trash",
        "slug": "take_out_trash",
        "frequency": "daily",
        "assignees": "alice,bob,charlie",
        "points": 3,
        "category": "kitchen",
    },
    {
        "name": "Feed the pet",
        "slug": "feed_pet",
        "frequency": "daily",
        "assignees": "alice,bob,charlie",
        "points": 2,
    },
    {
        "name": "Make your bed",
        "slug": "make_bed",
        "frequency": "daily",
        "assignees": "alice,bob,charlie",
        "points": 2,
        "category": "bedroom",
    },
    {
        "name": "Clean your room",
        "slug": "clean_room",
        "frequency": "manual",
        "assignees": "alice,bob,charlie",
        "points": 10,
        "points_by_assignee": "charlie:15",
        "category": "bedroom",
    },
