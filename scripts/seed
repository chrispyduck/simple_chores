        "slug": "mow_lawn",
        "frequency": "manual",
        "assignees": "bob",
        "points": 20,
        "category": "outdoor",
    },
    {
        "name": "Rake the leaves",
        "slug": "rake_leaves",
        "frequency": "once",
        "assignees": "alice,bob,charlie",
        "points": 15,
        "category": "outdoor",
    },
    {
        "name": "Reading homework",
        "slug": "homework_reading",
        "frequency": "daily",
        "assignees": "alice,charlie",
        "points": 5,
        "category": "homework",
    },
    {
