def request_json(base_url, token, path, data=None, *, what):
    request = urllib.request.Request(
        f"{base_url}{path}",
        data=None if data is None else json.dumps(data).encode(),
        method="GET" if data is None else "POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(request) as response:
            return json.loads(response.read() or b"{}")
    except urllib.error.HTTPError as err:
        detail = err.read().decode(errors="replace")
        sys.exit(f"{what} failed: HTTP {err.code} {err.reason}\n{detail}")
    except urllib.error.URLError as err:
        sys.exit(f"Could not reach {base_url}: {err.reason}")


def call_service(base_url, token, service, data, *, dry_run, return_response=False):
    if dry_run:
        print(f"  [dry-run] {service} {json.dumps(data)}")
        return None

    path = f"/api/services/{DOMAIN}/{service}"
    if return_response:
        path += "?return_response"
    return request_json(base_url, token, path, data, what=service)


def existing_slugs(base_url, token) -> dict[str, set[str]]:
    """Slugs of the categories, chores, and privileges already configured.

    Read from the integration's sensor attributes. Chores and privileges
    only get sensors once they have an assignee, which every seed entry does.
    """
    found = {"category_slug": set(), "chore_slug": set(), "privilege_slug": set()}
    for state in request_json(base_url, token, "/api/states", what="Reading states"):
        attributes = state.get("attributes", {})
        for key, slugs in found.items():
            if attributes.get(key):
                slugs.add(attributes[key])
    return found


def seed(
    base_url: str, token: str | None, *, dry_run: bool, force_activity: bool
) -> None:
    def call(service, data, **kwargs):
        return call_service(base_url, token, service, data, dry_run=dry_run, **kwargs)

    existing = (
        {"category_slug": set(), "chore_slug": set(), "privilege_slug": set()}
        if dry_run
        else existing_slugs(base_url, token)
    )

    def upsert(kind, items, slug_key):
        created = updated = 0
        for item in items:
            if item["slug"] in existing[slug_key]:
                call(f"update_{kind}", item)
                updated += 1
            else:
                call(f"create_{kind}", item)
                created += 1
        print(f"  {created} created, {updated} updated")

    # Categories first (chores reference them), then chores (privileges
    # link to them).
    print("Categories...")
    upsert("category", CATEGORIES, "category_slug")
    print("Chores...")
    upsert("chore", CHORES, "chore_slug")
    print("Privileges...")
    upsert("privilege", PRIVILEGES, "privilege_slug")

    if not dry_run and not force_activity:
        history = call("get_history", {}, return_response=True) or {}
        entries = history.get("service_response", {}).get("entries", [])
        if entries:
            print(
                f"Skipping simulated activity - {len(entries)} history entries "
                "already on record (use --force-activity to run it anyway)."
            )
            return

    print("Simulating activity...")
    call("mark_complete", {"chore_slug": "wash_dishes", "user": "alice"})
    call("mark_complete", {"chore_slug": "wash_dishes", "user": "bob"})
    call("mark_complete", {"chore_slug": "take_out_trash"})
    call("mark_complete", {"chore_slug": "make_bed", "user": "alice"})
    call("mark_complete", {"chore_slug": "make_bed", "user": "bob"})
    call("mark_complete", {"chore_slug": "homework_reading", "user": "alice"})
    call("mark_complete", {"chore_slug": "homework_math", "user": "bob"})
    call("mark_complete", {"chore_slug": "feed_pet"})

    # Undo and redo a couple of completions, for "uncompleted" history entries.
    call("mark_pending", {"chore_slug": "wash_dishes", "user": "alice"})
    call("mark_pending", {"chore_slug": "homework_math", "user": "bob"})
    call("mark_complete", {"chore_slug": "wash_dishes", "user": "alice"})
    call("mark_complete", {"chore_slug": "homework_math", "user": "bob"})

    # Explicitly clear charlie's completions, for "reset" history entries.
    call("reset_completed", {"user": "charlie"})

    # Request some chores but never finish them, so start_new_day below logs
    # "missed" history entries for them.
    call("mark_pending", {"chore_slug": "mow_lawn", "user": "bob"})
    call("mark_pending", {"chore_slug": "clean_room", "user": "charlie"})
    call("mark_pending", {"chore_slug": "rake_leaves"})

    call("adjust_points", {"user": "alice", "adjustment": 15})
    call(
        "temporarily_disable_privilege",
        {"privilege_slug": "late_bedtime", "user": "bob", "duration": 60},
    )

    print("Rolling over to a new day (resets completions, logs missed points)...")
    call("start_new_day", {})

    if dry_run:
        print("Done (dry run).")
        return

    result = call("get_history", {}, return_response=True) or {}
    entries = result.get("service_response", {}).get("entries", [])
    print(f"Done - {len(entries)} history entries now on record.")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--url", default=os.environ.get("HA_URL", "http://localhost:8123")
    )
    parser.add_argument("--token", default=os.environ.get("HA_TOKEN"))
    parser.add_argument(
        "--dry-run", action="store_true", help="print the calls without making them"
    )
    parser.add_argument(
        "--force-activity",
        action="store_true",
        help="simulate activity even if history entries already exist",
    )
    args = parser.parse_args()

    if not args.token and not args.dry_run:
        sys.exit(
            "No token provided. Set HA_TOKEN or pass --token.\n"
            "Create one from the HA profile page: click your name (bottom "
            "left) -> Security -> Long-Lived Access Tokens -> Create Token."
        )

    seed(
        args.url.rstrip("/"),
        args.token,
        dry_run=args.dry_run,
        force_activity=args.force_activity,
    )


if __name__ == "__main__":
    main()
